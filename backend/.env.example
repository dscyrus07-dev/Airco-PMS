# Application
APP_NAME="Management Tool API"
APP_ENV=development
DEBUG=true

# Versioned API prefix — must match the frontend's VITE_API_URL
API_V1_PREFIX=/api/v1

# Database — either set SUPABASE_DB_PASSWORD and let the app build the URL,
# or provide a full DATABASE_URL. Async driver: postgresql+asyncpg.
# NOTE: db.<ref>.supabase.co is IPv6-only. On networks without IPv6 or with a
# flaky resolver, use the project Supabase pooler/host from the dashboard
# (SUPABASE_DB_HOST + SUPABASE_DB_USER=postgres.<ref>, or a full DATABASE_URL).
SUPABASE_DB_HOST=db.asuzvovuecxuztynidss.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
# DATABASE_URL=postgresql+asyncpg://postgres:${SUPABASE_DB_PASSWORD}@db.asuzvovuecxuztynidss.supabase.co:5432/postgres

# Connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# Supabase services
SUPABASE_URL=https://asuzvovuecxuztynidss.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_S3_URL=https://asuzvovuecxuztynidss.storage.supabase.co/storage/v1/s3

# Auth / JWT — generate a strong secret, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS — comma-separated frontend origins
CORS_ORIGINS=http://localhost:3000

# Redis — cache, rate limiting, and the arq job queue. When unset the API
# degrades gracefully (in-memory rate limiter, embedded scheduler).
REDIS_URL=
# redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5

# Embedded scheduler — runs the template/repetitive generation tick inside
# the API process. Set false in production where the arq worker owns it.
RUN_EMBEDDED_SCHEDULER=true

# Rate limiting (Redis-backed when REDIS_URL is set)
RATE_LIMIT_ENABLED=true

# Media storage — "local" (UPLOAD_DIR) or "s3" (S3-compatible object store:
# AWS S3, Supabase Storage, MinIO). Production should use s3 so uploads
# survive container replacement.
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
# S3_ENDPOINT_URL=          # e.g. https://<ref>.storage.supabase.co/storage/v1/s3 or http://minio:9000
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BASE_URL=       # CDN/public base for stored object URLs
