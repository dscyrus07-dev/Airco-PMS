# Docker Compose environment — copy to .env (never commit .env)

# Local Postgres container (dev compose only — production uses DATABASE_URL)
POSTGRES_DB=mgmt
POSTGRES_USER=mgmt
POSTGRES_PASSWORD=mgmt-dev-password

# Required in production — generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Production externals (docker-compose.prod.yml)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
REDIS_URL=redis://host:6379/0
CORS_ORIGINS=https://app.example.com
HTTP_PORT=80

# Object storage (production uploads — STORAGE_BACKEND=s3)
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
