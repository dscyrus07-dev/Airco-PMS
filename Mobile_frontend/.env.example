# API base URL INCLUDING the /api/v1 prefix.
# Production default is baked into app.json (expo.extra.apiUrl) — this file
# is only needed for local development against a local backend.
#
# iOS simulator / same-machine dev:
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
#
# Android emulator (maps host loopback):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1
#
# Physical device on the same network:
# EXPO_PUBLIC_API_URL=http://<your-lan-ip>:8000/api/v1
